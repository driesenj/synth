// Module Layout

// A2  -  A1  -  A0
// A5  -  A4  -  A3
// A8  -  A7  -  A6
//
// A11 -  A10 -  A9
// D14 -  O0  -  O1

// ===== Pin Mapping =====
#define PIN_WT     A2
#define PIN_SUB    A1
#define PIN_ENV    A0
#define PIN_CUT    A5
#define PIN_RES    A4
#define PIN_DRV    A3
#define PIN_LFO    A8
#define PIN_FM     A7
#define PIN_DETUNE A6


#define PIN_1VOCT  A11
#define PIN_CV_1   A10
#define PIN_CV_2   A9

#define PIN_GATE   D5

#define PIN_ENC_1_CW D13
#define PIN_ENC_1_CCW D14
#define PIN_ENC_1_SW D8
#define PIN_ENC_2_CW D7
#define PIN_ENC_2_CCW D6
#define PIN_ENC_2_SW D9

